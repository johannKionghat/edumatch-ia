# Copier en .env — ce fichier ne contient QUE des valeurs factices.
# Aucun secret réel ne doit jamais être versionné.

# ─── Base de données ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edumatch
POSTGRES_USER=edumatch
POSTGRES_PASSWORD=changez_moi

# ─── MLflow ─────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Environnement ──────────────────────────────────────────────────
# dev | staging | prod — sélectionne configs/{valeur}.yaml, surchargé sur
# configs/base.yaml. Voir src/edumatch/config.py pour la règle de précédence.
EDUMATCH_ENV=dev

# Racine des données de travail (raw/, interim/, processed/, external/).
# Par défaut : data/ du dépôt (non versionné, sauf data/samples/). À
# surcharger uniquement quand ce n'est pas le poste de développement qui
# tourne : Scaleway, volume monté en conteneur, répertoire temporaire de CI.
# Une valeur vide, blanche ou relative est refusée explicitement.
# EDUMATCH_DATA_ROOT=/chemin/absolu/vers/les/donnees

# Surcharge ponctuelle d'un paramètre YAML, exemple (double underscore entre
# les niveaux) — à utiliser pour un réglage exceptionnel, pas en routine :
# EDUMATCH_MODELE__HYPERPARAMETRES__N_ESTIMATORS=500

# ─── RAG, brique secondaire ─────────────────────────────────────────
MISTRAL_API_KEY=

# ─── Cloud, uniquement pour le déploiement de démonstration ─────────
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=
