# Copier en .env — ce fichier ne contient QUE des valeurs factices.
# Aucun secret réel ne doit jamais être versionné.

# ─── Base de données ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edumatch
POSTGRES_USER=edumatch
POSTGRES_PASSWORD=changez_moi

# ─── MLflow ─────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Environnement ──────────────────────────────────────────────────
# dev | staging | prod — sélectionne configs/{valeur}.yaml, surchargé sur
# configs/base.yaml. Voir src/edumatch/config.py pour la règle de précédence.
EDUMATCH_ENV=dev

# Racine des données de travail (raw/, interim/, processed/, external/).
# Par défaut : data/ du dépôt (non versionné, sauf data/samples/). À
# surcharger uniquement quand ce n'est pas le poste de développement qui
# tourne : Scaleway, volume monté en conteneur, répertoire temporaire de CI.
# Une valeur vide, blanche ou relative est refusée explicitement.
# EDUMATCH_DATA_ROOT=/chemin/absolu/vers/les/donnees

# Surcharge ponctuelle d'un paramètre YAML, exemple (double underscore entre
# les niveaux) — à utiliser pour un réglage exceptionnel, pas en routine :
# EDUMATCH_MODELE__HYPERPARAMETRES__N_ESTIMATORS=500

# ─── RAG, brique secondaire ─────────────────────────────────────────
MISTRAL_API_KEY=

# ─── Cloud, uniquement pour le déploiement de démonstration ─────────
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=

# ─── Airflow en production (docker-compose.prod.yml, ADR 0019) ──────
# Ces variables ne servent QUE sur l'instance Scaleway dédiée à
# l'orchestrateur (terraform/airflow.tf, edumatch-cicd). Elles n'ont aucun
# effet sur la pile de développement (docker-compose.yml).

# Image du planificateur Airflow, publiée par la CI (.github/workflows/
# build-images.yml, dépôt edumatch-cicd) et étiquetée par l'empreinte courte
# du commit qui l'a produite — jamais `latest` en production. Exemple de
# forme, valeur factice :
EDUMATCH_AIRFLOW_IMAGE=rg.fr-par.scw.cloud/edumatch/edumatch-airflow:0000000

# Clé de chiffrement des connexions et variables stockées dans la base de
# métadonnées Airflow (mots de passe des connexions déclarées, secrets de
# XCom...). Doit être une clé Fernet valide (32 octets urlsafe-base64) ;
# celle-ci est factice et ne doit jamais servir. Générer la vraie valeur avec :
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=ZmFrZS1mZXJuZXQta2V5LW5lLWphbWFpcy11dGlsaXNlcg==

# Clé de session du serveur web Airflow (Flask). Une valeur aléatoire
# suffisamment longue ; celle-ci est factice. Générer la vraie valeur avec :
#   openssl rand -hex 32
AIRFLOW__WEBSERVER__SECRET_KEY=changez_moi_avec_openssl_rand_hex_32

# Identifiants du compte d'administration Airflow, créés une seule fois par
# le service `airflow-init` (docker-compose.prod.yml). Après le premier
# démarrage, un changement de ces valeurs ne modifie pas le compte déjà créé
# — le mot de passe se change alors depuis l'interface ou `airflow users
# reset-password`.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=changez_moi
AIRFLOW_ADMIN_EMAIL=admin@edumatch.invalid

# Base PostgreSQL de métadonnées Airflow — dédiée à l'orchestrateur, distincte
# de la base qui sert de backend au registre MLflow (celle-ci tourne sur une
# autre machine, le cluster Kapsule). `POSTGRES_ADMIN_PASSWORD` est le mot de
# passe du compte d'administration générique du conteneur `postgres` de
# `docker-compose.prod.yml` ; `AIRFLOW_DB_*` sont les identifiants applicatifs
# que `docker/postgres/init-airflow.sql` crée à partir d'eux au premier
# démarrage.
POSTGRES_ADMIN_PASSWORD=changez_moi
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changez_moi
