# Copier en .env — ce fichier ne contient QUE des valeurs factices.
# Aucun secret réel ne doit jamais être versionné.

# ─── Base de données ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edumatch
POSTGRES_USER=edumatch
POSTGRES_PASSWORD=changez_moi

# ─── MLflow ─────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Environnement ──────────────────────────────────────────────────
# dev | staging | prod — sélectionne le fichier dans configs/
EDUMATCH_ENV=dev

# ─── RAG, brique secondaire ─────────────────────────────────────────
MISTRAL_API_KEY=

# ─── Cloud, uniquement pour le déploiement de démonstration ─────────
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=
